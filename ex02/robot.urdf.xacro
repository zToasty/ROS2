<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pylesos">

  <!-- === Материалы === -->
  <xacro:property name="silver_color" value="0.7 0.7 0.7 1.0"/>
  <xacro:property name="black_color" value="0.05 0.05 0.05 1.0"/>
  <xacro:property name="darkgray_color" value="0.3 0.3 0.3 1.0"/>

  <material name="silver">
    <color rgba="${silver_color}"/>
  </material>
  <material name="black">
    <color rgba="${black_color}"/>
  </material>
  <material name="darkgray">
    <color rgba="${darkgray_color}"/>
  </material>

  <!-- === Параметры робота === -->
  <xacro:property name="base_radius" value="0.18"/>
  <xacro:property name="base_length" value="0.08"/>
  <xacro:property name="wheel_radius" value="0.04"/>
  <xacro:property name="wheel_length" value="0.02"/>
  <xacro:property name="caster_radius" value="0.025"/>

  <!-- === Макрос для колеса === -->
  <xacro:macro name="wheel" params="name x y z material">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0"
                 iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- === База робота === -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_length}"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_length}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0"
               iyy="0.02" iyz="0.0" izz="0.03"/>
    </inertial>
  </link>

  <!-- === Колёса === -->
  <xacro:wheel name="left_wheel" x="0" y="0.15" z="0" material="black"/>
  <xacro:wheel name="right_wheel" x="0" y="-0.15" z="0" material="black"/>

  <!-- === Опорное колесо === -->
  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="darkgray"/>
      <origin xyz="-0.12 0 -0.025"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <origin xyz="-0.12 0 -0.025"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0"
               iyy="0.0002" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="-0.12 0 -0.04"/>
  </joint>

</robot>
